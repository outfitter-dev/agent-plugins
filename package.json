{
  "name": "@outfitter/agent-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "upstream:sync": "bun scripts/upstream.ts",
    "upstream:status": "bun scripts/upstream.ts --ref main --check",
    "validate": "bun scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint scripts test",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "bun test ./test",
    "ci": "bun run typecheck && bun run lint && bun run format:check && bun run validate && bun run test",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "lefthook"
  ]
}
